# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-замените-на-свой-токен

# Публичный адрес Mini App (обязательно HTTPS)
WEBAPP_URL=https://chess.example.com

# Где слушает сервер (nginx проксирует сюда)
HOST=127.0.0.1
PORT=8090

# Файл базы данных (по умолчанию data/chess.db)
# DB_PATH=/opt/tg-chess/data/chess.db

# Свой адрес Bot API, если api.telegram.org недоступен с сервера
# TELEGRAM_API=https://api.telegram.org

# Вход без Telegram для проверки в обычном браузере. На боевом сервере держите 0!
DEV_MODE=0
